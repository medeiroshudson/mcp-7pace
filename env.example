# 7Pace Timetracker MCP Server Configuration

# Your 7pace organization name (e.g., "labournet" for labournet.timehub.7pace.com)
SEVENPACE_ORGANIZATION=your_organization

# Your 7pace API token (generate from 7pace Settings → Reporting and API)
SEVENPACE_TOKEN=your_7pace_api_token_here

# Optional: Custom base URL if using a different endpoint
# SEVENPACE_BASE_URL=https://your-org.timehub.7pace.com

# Optional: Write timeout in milliseconds for create/update/delete operations (default: 30000)
# SEVENPACE_WRITE_TIMEOUT_MS=30000

# Optional: IANA timezone ID for date-to-timestamp conversion (default: UTC-3)
# Used when logging time with a date-only input (YYYY-MM-DD)
# Examples: America/Sao_Paulo, America/New_York, Europe/London, UTC
# TZ=America/Sao_Paulo

# Optional: Set PORT to enable HTTP (Streamable HTTP stateless) transport instead of stdio
# When PORT is set, the server listens on /mcp endpoint
# PORT=3000